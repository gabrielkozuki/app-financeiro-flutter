<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: a marca centralizada sobre a superfície do app. O Flutter remove
     esta tela sozinho quando desenha o primeiro frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/splash_marca" />
    </item>
</layer-list>
